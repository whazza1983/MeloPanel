# ===================== MeloPanel – Settings =====================
# Template: copy to .env and fill in (cp .env.example .env)

# ---------- Discord ----------
# Token from the Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# ID of your Discord server (right-click the server -> "Copy Server ID"; Developer Mode must be enabled)
DISCORD_GUILD_ID=

# ---------- Navidrome (music source) ----------
# Access to the Navidrome server that MeloPanel streams music from
# With Docker (docker-compose.yml) this value is overridden: http://navidrome:4533
# Without Docker: the address where Navidrome is reachable
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
# 0 = original quality, otherwise e.g. 320 (kbit/s) to have Navidrome transcode
NAVIDROME_MAX_BITRATE=0

# ---------- Web panel ----------
# The panel only listens locally; a reverse proxy (Apache/Nginx) forwards the domain to it
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Public address of the panel (shown by the Discord command /panel) – domain or IP,
# e.g. https://music.your-domain.com or http://YOUR-SERVER-IP:8095
PANEL_URL=https://music.your-domain.com
# Long random value, e.g. generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# true with domain + HTTPS (recommended) · false for IP-only access (http://), otherwise login will not work
COOKIE_SECURE=true

# ---------- Admin ----------
# Created on the very first start. If no password is set, one is generated and written to the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- Miscellaneous ----------
DB_PATH=data/panel.db
DEFAULT_VOLUME=50
# The bot leaves the voice channel after this many minutes without music (0 = never)
IDLE_DISCONNECT_MINUTES=0
# Time zone for the panel's schedule
TIMEZONE=Europe/Berlin
